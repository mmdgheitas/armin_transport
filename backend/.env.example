# Armin Transport backend: configuration.
#
# Copy this file to backend/.env and adjust it. Real environment variables take precedence
# over the file. Lines that are commented out show the default value.
# The application checks these values when it starts and refuses to run in production
# with settings that are unsafe (weak secret, SQLite, relative storage path, CORS "*").

# --------------------------------------------------------------------------- environment
# development | testing | production
APP_ENV=development
# Flask debug mode. Ignored (always off) in production.
#APP_DEBUG=false

# --------------------------------------------------------------------------- database
# MySQL 8 with the utf8mb4 character set. Required outside of the test suite.
DATABASE_URL=mysql+pymysql://armin_app:change-this-password@127.0.0.1:3306/armin_transport?charset=utf8mb4
# The test suite uses this database (tables are dropped and recreated). Without it, a temporary SQLite file.
#TEST_DATABASE_URL=mysql+pymysql://armin_app:change-this-password@127.0.0.1:3306/armin_transport_test?charset=utf8mb4
#DB_POOL_SIZE=10
#DB_MAX_OVERFLOW=10
#DB_POOL_RECYCLE_SECONDS=1800

# --------------------------------------------------------------------------- authentication
# Signs the access tokens. Required in production: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development a random key is generated at every start (everybody is signed out by a restart).
JWT_SECRET_KEY=
#JWT_ALGORITHM=HS256
#JWT_ISSUER=armin-transport
# Access tokens live for minutes, refresh tokens for days. A refresh token is replaced every time it is used.
#JWT_ACCESS_TOKEN_TTL_SECONDS=900
#JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
#PASSWORD_MIN_LENGTH=10
# Argon2id cost. Raise the memory cost as far as the server allows; every login pays it once.
#ARGON2_TIME_COST=3
#ARGON2_MEMORY_COST_KIB=65536
#ARGON2_PARALLELISM=4

# --------------------------------------------------------------------------- documents
# Where uploaded files are kept. Must be an absolute path in production, outside of any directory
# that a web server serves, and included in the backups together with the database.
#STORAGE_ROOT=/var/lib/armin-transport/storage
#MAX_UPLOAD_SIZE_BYTES=10485760
#MAX_FILES_PER_UPLOAD=10
# May narrow the list of accepted types, never extend it (the content of every type is verified).
#ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,webp,doc,docx,xls,xlsx,txt
# Optional additional restriction by detected MIME type.
#ALLOWED_UPLOAD_MIME_TYPES=
# Compare the stored checksum before every download; a mismatch is refused and recorded.
#VERIFY_CHECKSUM_ON_DOWNLOAD=true
# Whether a new document is visible to the customer unless the uploader says otherwise.
#DOCUMENT_CUSTOMER_VISIBLE_DEFAULT=true
# Deleting a document hides it and keeps the file. true also removes the file from the disk.
#DOCUMENT_PURGE_FILE_ON_DELETE=false
# Optional malware scanner, run without a shell for every uploaded file. The path of the file
# replaces {path} or is appended. Exit code 0 = clean, 1 = infected; anything else counts as a
# failure of the scanner and the upload is refused. Example: clamdscan --no-summary --fdpass
#MALWARE_SCAN_COMMAND=
#MALWARE_SCAN_TIMEOUT_SECONDS=60

# --------------------------------------------------------------------------- business rules
# What employees may do besides the central administrator (see docs/REQUIREMENTS.md).
#EMPLOYEE_CAN_USE_MANUAL_TRACKING_CODE=false
#EMPLOYEE_CAN_CHANGE_TRACKING_CODE=true
#EMPLOYEE_CAN_ARCHIVE_SHIPMENTS=true
#EMPLOYEE_CAN_DELETE_DOCUMENTS=false

# --------------------------------------------------------------------------- tracking codes
# Generated codes: 16 random characters in groups of four (ABCD-EFGH-JKLM-NPQR), optionally with a prefix.
#TRACKING_CODE_AUTO_LENGTH=16
#TRACKING_CODE_AUTO_GROUP_SIZE=4
#TRACKING_CODE_AUTO_PREFIX=
# Shortest manual code that is accepted.
#TRACKING_CODE_MIN_LENGTH=6
#TRACKING_CODE_MAX_ATTEMPTS=8

# --------------------------------------------------------------------------- customer portal
# How long a customer may look at a shipment after entering its tracking code.
#CUSTOMER_SESSION_TTL_SECONDS=1800
#CUSTOMER_SHOW_COMPANY_NAME=true
#CUSTOMER_SHOW_DESCRIPTION=false
#CUSTOMER_ALLOW_ARCHIVED_SHIPMENTS=false

# --------------------------------------------------------------------------- rate limits
# "<max events>/<window in seconds>". Counters are kept in the database, so the limits hold
# across all worker processes.
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_LOGIN_IP=30/300
#RATE_LIMIT_LOGIN_USER=10/900
#RATE_LIMIT_REFRESH_IP=120/60
#RATE_LIMIT_CUSTOMER_LOOKUP_IP=10/60
#RATE_LIMIT_CUSTOMER_LOOKUP_FAILURES_IP=20/3600
#RATE_LIMIT_CUSTOMER_ACCESS_IP=240/60

# --------------------------------------------------------------------------- HTTP
# Origins of browser clients that are served from another address than the API. Not needed when
# the backend serves the web client itself or a reverse proxy puts both under one address.
# The Android and Windows apps are not browsers and need no entry here.
#CORS_ALLOWED_ORIGINS=https://app.example.com
# Number of reverse proxies in front of the application whose X-Forwarded-* headers are trusted
# (1 behind nginx). With 0 the headers are ignored and the address of the proxy counts as the client.
#TRUSTED_PROXY_COUNT=0
# Who may embed the pages in a frame (Content-Security-Policy frame-ancestors).
#FRAME_ANCESTORS='none'
# Strict-Transport-Security header; on by default in production.
#HSTS_ENABLED=true
# Let the backend serve the built web client (web/dist) besides the API: one process, one address.
#SERVE_WEB_APP=false
#WEB_APP_DIR=/srv/armin-transport/web/dist

# --------------------------------------------------------------------------- lists
#DEFAULT_PAGE_SIZE=20
#MAX_PAGE_SIZE=100

# --------------------------------------------------------------------------- logging
#LOG_LEVEL=INFO
# text | json (default: json in production)
#LOG_FORMAT=text

# --------------------------------------------------------------------------- gunicorn (gunicorn.conf.py)
#BIND=127.0.0.1:8000
#WEB_CONCURRENCY=5
#GUNICORN_THREADS=4
#GUNICORN_TIMEOUT=120
# Addresses of the reverse proxy that Gunicorn accepts X-Forwarded-* headers from.
#FORWARDED_ALLOW_IPS=127.0.0.1
